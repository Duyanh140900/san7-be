  "info": {
    "title": "Sân 7 API",
    "description": "API cho app Sân 7: cáp kèo, đặt sân, quản lý đội",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token lấy từ google_sign_in (serverClientId = Web client ID)"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "Position": {
        "type": "string",
        "enum": [
          "goalkeeper",
          "defender",
          "midfielder",
          "forward"
        ]
      },
      "TeamLevel": {
        "type": "string",
        "enum": [
          "sieu_yeu",
          "yeu",
          "tby",
          "tb",
          "tbk",
          "gioi"
        ]
      },
      "TeamRole": {
        "type": "string",
        "enum": [
          "captain",
          "vice",
          "treasurer",
          "member"
        ]
      },
      "MemberStatus": {
        "type": "string",
        "enum": [
          "pending",
          "active"
        ]
      },
      "MyTeamDto": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "crestColor": {
            "type": "string",
            "example": "#0066CC"
          },
          "area": {
            "type": "string"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamLevel"
              }
            ]
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MemberStatus"
              }
            ]
          }
        },
        "required": [
          "teamId",
          "name",
          "crestColor",
          "area",
          "level",
          "role",
          "status"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Position"
              }
            ]
          },
          "shirtNumber": {
            "type": "integer",
            "nullable": true
          },
          "area": {
            "type": "string",
            "nullable": true
          },
          "profileCompleted": {
            "type": "boolean",
            "description": "Đã điền hồ sơ cầu thủ (bước 2 màn 12)"
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyTeamDto"
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "profileCompleted",
          "teams"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "description": "Thời hạn access token (giây)"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "description": "Thời hạn access token (giây)"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "position": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Position"
              }
            ]
          },
          "shirtNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "area": {
            "type": "string",
            "maxLength": 50,
            "example": "Cầu Giấy"
          }
        }
      },
      "Platform": {
        "type": "string",
        "enum": [
          "android",
          "ios",
          "web"
        ]
      },
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "fcmToken": {
            "type": "string"
          },
          "platform": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Platform"
              }
            ]
          }
        },
        "required": [
          "fcmToken",
          "platform"
        ]
      },
      "CreateTeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "FC Cầu Giấy"
          },
          "area": {
            "type": "string",
            "maxLength": 50,
            "example": "Cầu Giấy"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamLevel"
              }
            ]
          },
          "crestColor": {
            "type": "string",
            "example": "#0066CC"
          }
        },
        "required": [
          "name",
          "area",
          "level"
        ]
      },
      "TeamDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "crestColor": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamLevel"
              }
            ]
          },
          "inviteCode": {
            "type": "string"
          },
          "inviteExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "crestColor",
          "area",
          "level",
          "inviteCode"
        ]
      },
      "TeamInvitePreviewDto": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "crestColor": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamLevel"
              }
            ]
          },
          "memberCount": {
            "type": "integer"
          }
        },
        "required": [
          "teamId",
          "name",
          "crestColor",
          "area",
          "level",
          "memberCount"
        ]
      },
      "JoinTeamDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "CG7-2486"
          }
        },
        "required": [
          "code"
        ]
      },
      "MembershipDto": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "teamName": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TeamRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MemberStatus"
              }
            ]
          }
        },
        "required": [
          "teamId",
          "teamName",
          "role",
          "status"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "validation_failed",
            "description": "Mã lỗi ổn định để app xử lý"
          },
          "message": {
            "type": "string",
            "example": "Dữ liệu không hợp lệ"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      }
    }
  }
}
