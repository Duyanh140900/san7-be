// Sân 7: mô hình dữ liệu. Quy ước: khoá chính uuid, thời gian timestamptz,
// tiền là bigint VND, tên bảng/cột snake_case.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Position {
  goalkeeper
  defender
  midfielder
  forward
}

enum TeamLevel {
  sieu_yeu
  yeu
  tby
  tb
  tbk
  gioi
}

enum TeamRole {
  captain
  vice
  treasurer
  member
}

enum MemberStatus {
  pending
  active
}

enum EventKind {
  match
  internal
  other
}

enum AttendanceStatus {
  go
  maybe
  no
}

enum FundType {
  income
  expense
  fine
}

enum PostType {
  find_opponent
  recruit
  pass_pitch
}

enum PostDeal {
  split
  loser_pays
  drinks
  friendly
}

enum PostStatus {
  open
  matched
  closed
}

enum RequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

enum MatchStatus {
  scheduled
  finished
  cancelled
}

enum NotificationCategory {
  match
  booking
  team
  fund
}

enum BookingStatus {
  held
  confirmed
  cancelled
}

enum PitchSource {
  manual
  osm
}

enum ReactionTarget {
  post
  comment
}

enum ReactionKind {
  like
  love
  fire
  haha
  sad
}

enum Platform {
  android
  ios
  web
}

/// Trạng thái của một lịch đăng kèo. Lịch lặp tuần giữ lại sau mỗi lần đăng.
enum PostScheduleStatus {
  scheduled
  cancelled
}

/// Vòng đời upload ảnh: object luôn vào quarantine trước, chỉ `ready` mới
/// được phép tham chiếu từ dữ liệu nghiệp vụ.
enum MediaUploadStatus {
  pending
  processing
  ready
  rejected
  expired
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSub   String    @unique @map("google_sub")
  email       String
  phone       String?
  name        String
  avatarUrl   String?   @map("avatar_url")
  position    Position?
  shirtNumber Int?      @map("shirt_number") @db.SmallInt
  area        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  devices              Device[]
  memberships          TeamMember[]
  refreshTokens        RefreshToken[]
  teamsCreated         Team[]
  attendances          Attendance[]
  eventsCreated        Event[]
  fundTxMember         FundTransaction[]     @relation("FundMember")
  fundTxCreated        FundTransaction[]     @relation("FundCreator")
  posts                Post[]
  bookingsMade         Booking[]
  matchStats           MatchPlayerStat[]
  reviewsMade          TeamReview[]
  requestsSent         MatchRequest[]
  postApplications     PostApplication[]
  notifications        Notification[]
  comments             Comment[]
  matchMessages        MatchMessage[]
  chatReads            MatchChatRead[]
  reactions            Reaction[]
  postSchedules        PostSchedule[]
  notificationSettings NotificationSettings?
  mediaUploads         MediaUpload[]

  @@map("users")
}

/// Tùy chọn thông báo theo tài khoản. Một hàng được tạo lười ở lần đọc/cập nhật đầu tiên.
model NotificationSettings {
  userId       String   @id @map("user_id") @db.Uuid
  matchUpdates Boolean  @default(true) @map("match_updates")
  teamActivity Boolean  @default(true) @map("team_activity")
  community    Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// sha256 của token, không lưu token gốc
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fcmToken  String   @unique @map("fcm_token")
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Team {
  mediaUploads    MediaUpload[]
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  /// màu huy hiệu dạng #RRGGBB
  crestColor      String    @map("crest_color")
  area            String
  level           TeamLevel
  inviteCode      String    @unique @map("invite_code")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  /// quỹ tháng mỗi người (VND), 0 = không thu quỹ tháng
  monthlyDue      BigInt    @default(0) @map("monthly_due")
  /// số dư quỹ (VND), cập nhật trong transaction mỗi khi thêm/xoá khoản
  fundBalance     BigInt    @default(0) @map("fund_balance")
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       User              @relation(fields: [createdById], references: [id])
  members         TeamMember[]
  events          Event[]
  transactions    FundTransaction[]
  fineRules       FineRule[]
  posts           Post[]
  postSchedules   PostSchedule[]
  bookings        Booking[]
  requests        MatchRequest[]
  homeMatches     Match[]           @relation("HomeTeam")
  reviewsGiven    TeamReview[]      @relation("ReviewFrom")
  reviewsReceived TeamReview[]      @relation("ReviewTo")
  matchStats      MatchPlayerStat[]
  awayMatches     Match[]           @relation("AwayTeam")

  @@index([createdById])
  @@map("teams")
}

model TeamMember {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String       @map("team_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      TeamRole     @default(member)
  status    MemberStatus @default(pending)
  /// thời điểm được duyệt vào đội (null khi còn chờ)
  joinedAt  DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Lịch đội: trận, đá nội bộ, sự kiện khác. Trận gắn với kèo/đối thủ từ M2.
model Event {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  kind        EventKind
  title       String
  startAt     DateTime  @map("start_at") @db.Timestamptz(6)
  endAt       DateTime  @map("end_at") @db.Timestamptz(6)
  location    String?
  note        String?
  /// số người tối thiểu cần đi
  minPlayers  Int?      @map("min_players") @db.SmallInt
  /// trận sinh ra khi chốt kèo (mỗi đội một event cùng matchId)
  matchId     String?   @map("match_id") @db.Uuid
  /// lịch sinh ra khi xác nhận đặt sân
  bookingId   String?   @unique @map("booking_id") @db.Uuid
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id])
  match        Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  booking      Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  attendances  Attendance[]
  transactions FundTransaction[]

  @@index([teamId, startAt])
  @@index([matchId])
  @@index([createdById])
  @@map("events")
}

model Attendance {
  eventId   String           @map("event_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    AttendanceStatus
  note      String?
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("attendances")
}

/// Thu / chi / phạt. Tiền là số nguyên VND. Phạt chưa nộp (paid = false) không tính vào số dư.
model FundTransaction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  type        FundType
  amount      BigInt
  category    String
  /// người nộp (thu), người chi (chi), người bị phạt (phạt)
  memberId    String?   @map("member_id") @db.Uuid
  eventId     String?   @map("event_id") @db.Uuid
  /// kỳ quỹ tháng dạng YYYY-MM (chỉ với khoản quỹ tháng)
  period      String?
  /// các khoản tạo cùng một lần (nhiều người nộp)
  batchId     String?   @map("batch_id") @db.Uuid
  /// khoá khoản do hệ thống tự ghi (vd tiền sân sau trận) để không ghi hai lần
  autoKey     String?   @unique @map("auto_key")
  note        String?
  /// Khoá object ảnh biên lai đã finalize; chỉ có cho giao dịch quỹ của đúng đội.
  receiptKey  String?   @map("receipt_key")
  paid        Boolean   @default(true)
  /// thời điểm tiền thực vào/ra quỹ (null = phạt chưa nộp); dùng cho thống kê theo tháng
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member    User?  @relation("FundMember", fields: [memberId], references: [id], onDelete: SetNull)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User   @relation("FundCreator", fields: [createdById], references: [id])

  @@index([teamId, createdAt])
  @@index([teamId, period])
  @@index([teamId, paidAt])
  @@index([memberId])
  @@index([eventId])
  @@index([createdById])
  @@index([receiptKey])
  @@map("fund_transactions")
}

model FineRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  name      String
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("fine_rules")
}

/// Kèo trên Bảng tin: tìm đối, tuyển người, pass sân.
model Post {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String     @map("team_id") @db.Uuid
  authorId      String     @map("author_id") @db.Uuid
  type          PostType
  startAt       DateTime   @map("start_at") @db.Timestamptz(6)
  endAt         DateTime   @map("end_at") @db.Timestamptz(6)
  /// tên sân gõ tay (M3 thêm pitch_id, booking_id)
  pitchName     String?    @map("pitch_name")
  /// sân và lượt đặt gắn với kèo (khi chọn từ sân đã đặt)
  pitchId       String?    @map("pitch_id") @db.Uuid
  bookingId     String?    @unique @map("booking_id") @db.Uuid
  /// khu vực của kèo (mặc định lấy khu vực đội) để lọc Bảng tin
  area          String
  level         TeamLevel
  deal          PostDeal?
  /// tỷ lệ chia tiền sân đội thắng – đội thua (%), chỉ khi deal = split
  ratioWin      Int?       @map("ratio_win") @db.SmallInt
  ratioLose     Int?       @map("ratio_lose") @db.SmallInt
  /// tiền sân (VND) để tính mỗi đội trả bao nhiêu; với pass sân là giá nhượng
  pitchPrice    BigInt?    @map("pitch_price")
  /// tuyển người: vị trí cần và số người
  positions     Position[]
  playersNeeded Int?       @map("players_needed") @db.SmallInt
  body          String?
  /// Khóa object ảnh, theo thứ tự hiển thị (tối đa 4; kiểm tra sở hữu trước khi lưu).
  media         String[]   @default([])
  status        PostStatus @default(open)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author   User           @relation(fields: [authorId], references: [id])
  requests MatchRequest[]
  applications PostApplication[]
  comments Comment[]
  match    Match?
  pitch    Pitch?         @relation(fields: [pitchId], references: [id], onDelete: SetNull)
  booking  Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  schedule PostSchedule?  @relation("PublishedSchedule")

  @@index([status, startAt])
  @@index([teamId, createdAt])
  @@index([authorId])
  @@index([pitchId])
  @@map("posts")
}

/// Bản nháp kèo sẽ được worker BullMQ công bố đúng giờ. payload là CreatePostDto
/// đã được kiểm tra ở boundary; worker kiểm tra lại thời gian trước khi công bố.
model PostSchedule {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String             @map("team_id") @db.Uuid
  authorId        String             @map("author_id") @db.Uuid
  payload         Json
  scheduledAt     DateTime           @map("scheduled_at") @db.Timestamptz(6)
  repeatWeekly    Boolean            @default(false) @map("repeat_weekly")
  pausedUntil     DateTime?          @map("paused_until") @db.Timestamptz(6)
  status          PostScheduleStatus @default(scheduled)
  publishedPostId String?            @unique @map("published_post_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author        User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedPost Post? @relation("PublishedSchedule", fields: [publishedPostId], references: [id], onDelete: SetNull)

  @@index([teamId, status, scheduledAt])
  @@index([authorId, status, scheduledAt])
  @@map("post_schedules")
}

/// Ý định upload được tạo trước khi cấp presigned PUT URL. Đây là nguồn sự
/// thật để giới hạn quota, kiểm tra ownership và dọn object quarantine.
model MediaUpload {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String            @map("owner_id") @db.Uuid
  /// Đội sở hữu ảnh (bắt buộc với receipt: chỉ thành viên active của đội được xem)
  teamId         String?           @map("team_id") @db.Uuid
  purpose        String
  expectedSize   Int               @map("expected_size")
  quarantineKey  String            @unique @map("quarantine_key")
  publicKey      String            @unique @map("public_key")
  status         MediaUploadStatus @default(pending)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  finalizedAt    DateTime?         @map("finalized_at") @db.Timestamptz(6)
  referencedAt   DateTime?         @map("referenced_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
  @@map("media_uploads")
}

/// Bình luận dưới kèo. Chỉ M5 dùng bình luận cấp một; parent/reply có thể bổ sung sau.
model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([userId])
  @@map("comments")
}

/// Cảm xúc dùng target đa hình để có thể áp dụng cho kèo và bình luận.
model Reaction {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType ReactionTarget @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  kind       ReactionKind
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId, kind])
  @@index([userId])
  @@map("reactions")
}

/// Yêu cầu nhận kèo của một đội. Tự hết hạn sau 2 giờ (hoặc khi tới giờ đá).
model MatchRequest {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String        @map("post_id") @db.Uuid
  teamId      String        @map("team_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  peopleCount Int           @map("people_count") @db.SmallInt
  /// tỷ lệ đề xuất; vắng = đồng ý tỷ lệ của kèo
  ratioWin    Int?          @map("ratio_win") @db.SmallInt
  ratioLose   Int?          @map("ratio_lose") @db.SmallInt
  message     String?
  status      RequestStatus @default(pending)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  respondedAt DateTime?     @map("responded_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([postId, status])
  @@index([teamId, status])
  @@index([createdById])
  @@map("match_requests")
}

/// Đơn ứng tuyển cá nhân cho kèo tuyển người. Mỗi người chỉ ứng tuyển một lần cho mỗi kèo.
model PostApplication {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String            @map("post_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  position  Position?
  note      String?
  status    ApplicationStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_applications")
}

/// Trận giữa hai đội (chốt từ kèo). Kết quả, thống kê thêm ở M4.
model Match {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId           String?     @unique @map("post_id") @db.Uuid
  homeTeamId       String      @map("home_team_id") @db.Uuid
  awayTeamId       String      @map("away_team_id") @db.Uuid
  startAt          DateTime    @map("start_at") @db.Timestamptz(6)
  endAt            DateTime    @map("end_at") @db.Timestamptz(6)
  location         String?
  status           MatchStatus @default(scheduled)
  /// tiền sân và tỷ lệ chia (đội thắng – đội thua) đã chốt lúc nhận kèo; null = không chia tiền sân
  pitchPrice       BigInt?     @map("pitch_price")
  ratioWin         Int?        @map("ratio_win") @db.SmallInt
  ratioLose        Int?        @map("ratio_lose") @db.SmallInt
  homeScore        Int?        @map("home_score") @db.SmallInt
  awayScore        Int?        @map("away_score") @db.SmallInt
  /// đội nhập tỉ số gần nhất; đội còn lại xác nhận (confirmedAt) hoặc sửa lại
  reportedByTeamId String?     @map("reported_by_team_id") @db.Uuid
  reportedAt       DateTime?   @map("reported_at") @db.Timestamptz(6)
  confirmedAt      DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  post     Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  homeTeam Team              @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam Team              @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  events   Event[]
  stats    MatchPlayerStat[]
  reviews  TeamReview[]
  messages MatchMessage[]
  chatReads MatchChatRead[]

  @@index([homeTeamId, startAt])
  @@index([awayTeamId, startAt])
  @@map("matches")
}

/// Tin nhắn trong phòng chat của một kèo đã chốt (chỉ thành viên hai đội).
model MatchMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  /// đội của người gửi tại thời điểm gửi
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt, id])
  @@map("match_messages")
}

/// Mốc gần nhất một đội đã mở cuộc trò chuyện của trận.
model MatchChatRead {
  matchId    String   @map("match_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @map("last_read_at") @db.Timestamptz(6)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, teamId])
  @@index([userId])
  @@map("match_chat_reads")
}

/// Thông báo trong app. Đẩy qua FCM do worker gửi sau khi commit.
model Notification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  /// loại ổn định, vd request.received, request.accepted
  type      String
  category  NotificationCategory
  title     String
  body      String
  /// dữ liệu để app điều hướng: postId, requestId, teamId...
  payload   Json                 @default("{}")
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Sân bóng (dữ liệu mẫu seed bằng `node dist/seed.js`). Vị trí là PostGIS geography.
model Pitch {
  id          String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                               @unique
  osmId       String?                              @unique @map("osm_id")
  source      PitchSource                          @default(manual)
  name        String
  district    String
  address     String
  location    Unsupported("geography(Point,4326)")
  /// số sân 7 của cơ sở
  courtsCount Int                                  @map("courts_count") @db.SmallInt
  /// độ dài mỗi khung giờ (phút)
  slotMinutes Int                                  @default(90) @map("slot_minutes") @db.SmallInt
  /// khung giờ trong ngày (giờ VN): [{ "start": "19:00", "price": 600000 }]
  slots       Json
  priceEstimated Boolean                           @default(false) @map("price_estimated")
  amenities   String[]
  phone       String?
  openingHours String?                             @map("opening_hours")
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings Booking[]
  posts    Post[]

  @@index([location], type: Gist)
  @@index([district])
  @@map("pitches")
}

/// Lượt đặt sân: giữ chỗ 10 phút (held) rồi xác nhận (confirmed), trả tiền tại sân.
model Booking {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// mã đưa cho quầy, vd SC-7Q2K
  code        String        @unique
  pitchId     String        @map("pitch_id") @db.Uuid
  teamId      String        @map("team_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  courtNo     Int           @map("court_no") @db.SmallInt
  startAt     DateTime      @map("start_at") @db.Timestamptz(6)
  endAt       DateTime      @map("end_at") @db.Timestamptz(6)
  status      BookingStatus @default(held)
  /// tiền sân (VND) tại thời điểm đặt
  price       BigInt
  /// tiền cọc (VND), 0 ở bản trả tại sân
  deposit     BigInt        @default(0)
  note        String?
  /// hết hạn giữ chỗ (chỉ khi held)
  heldUntil   DateTime?     @map("held_until") @db.Timestamptz(6)
  /// "pitchId:courtNo:startAt" khi còn chiếm chỗ, null khi đã huỷ. Unique chặn đặt trùng sân.
  slotKey     String?       @unique @map("slot_key")
  confirmedAt DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  pitch     Pitch  @relation(fields: [pitchId], references: [id])
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])
  event     Event?
  post      Post?

  @@index([teamId, startAt])
  @@index([pitchId, startAt])
  @@index([createdById])
  @@index([status, heldUntil])
  @@map("bookings")
}

/// Thành tích của một cầu thủ trong một trận (do đội của cầu thủ nhập).
model MatchPlayerStat {
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// đội cầu thủ khoác áo trong trận này
  teamId    String   @map("team_id") @db.Uuid
  goals     Int      @default(0) @db.SmallInt
  assists   Int      @default(0) @db.SmallInt
  /// cầu thủ hay nhất do đội của cầu thủ chọn
  mvp       Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("match_player_stats")
}

/// Đánh giá đội đối thủ sau trận (mỗi đội một đánh giá cho mỗi trận).
model TeamReview {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  fromTeamId  String   @map("from_team_id") @db.Uuid
  toTeamId    String   @map("to_team_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  /// uy tín, đúng giờ (1–5)
  reputation  Int      @db.SmallInt
  fairplay    Int      @db.SmallInt
  /// on_time, good_play, friendly, fair_pay, full_squad
  tags        String[]
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromTeam  Team  @relation("ReviewFrom", fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeam    Team  @relation("ReviewTo", fields: [toTeamId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@unique([matchId, fromTeamId])
  @@index([toTeamId, createdAt])
  @@index([createdById])
  @@map("team_reviews")
}
