# Chép thành .env rồi điền giá trị. KHÔNG commit .env.
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL + PostGIS
POSTGRES_USER=san7
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=san7
POSTGRES_PORT=5432
# Dùng khi chạy Prisma/Nest trực tiếp trên máy (ngoài Docker)
DATABASE_URL=postgresql://san7:doi-mat-khau-nay@localhost:5432/san7?schema=public

# Redis
REDIS_PASSWORD=doi-mat-khau-redis
REDIS_PORT=6379
REDIS_URL=redis://:doi-mat-khau-redis@localhost:6379

# Kho file chuẩn S3 (SeaweedFS trong Docker; sau đổi sang Cloudflare R2)
SEAWEEDFS_TAG=latest
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=san7-access
S3_SECRET_KEY=doi-khoa-bi-mat-s3

# Xác thực
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=doi-chuoi-ngau-nhien-dai
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Web client ID trong Google Cloud Console (audience khi kiểm tra ID token)
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Thông báo đẩy (FCM): nội dung file service account của Firebase, mã hoá base64 trên một dòng.
# Để trống thì không gửi push (thông báo trong app vẫn chạy).
FIREBASE_SERVICE_ACCOUNT=

# Cổng
API_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
# Trên VPS: api.tenmien.vn
CADDY_SITE=:80

# Worker
WORKER_CPUS=1.0
WORKER_MEMORY=768M

# Cloudflare Tunnel (chỉ khi dùng profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
